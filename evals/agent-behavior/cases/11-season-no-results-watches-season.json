            "calls": [
                { "method": "POST", "path": "/api/search", "body": { "query": "Lantern Bay", "season": 3 } },
                { "method": "POST", "path": "/api/watchlist", "body": { "title": "Lantern Bay season 3" } }
            ],
            "text": "Watching for it."
        },
        {
            "calls": [
                { "method": "POST", "path": "/api/search", "body": { "query": "Lantern Bay", "season": 3 } },
                { "method": "POST", "path": "/api/watchlist", "body": { "title": "Lantern Bay", "mediaType": "tv" } }
            ],
