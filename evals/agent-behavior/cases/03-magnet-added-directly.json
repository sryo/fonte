        {
            "method": "POST", "path": "/api/search", "body": { "query": { "$regex": "3f8a6c2e9b1d4f7a0c5e8b2d6f9a1c4e7b0d3f6a", "$flags": "i" } },
            "json": { "ok": true, "action": "added", "torrent": { "id": "tr_deb13", "infoHash": "3f8a6c2e9b1d4f7a0c5e8b2d6f9a1c4e7b0d3f6a", "name": "Debian.13.0.0.amd64.netinst.iso", "status": "adding", "progress": 0 } }
        },
        { "method": "POST", "path": "/api/search", "json": { "ok": true, "query": "Debian 13", "quality": "1080p", "resultCount": 0, "results": [] } },
        { "method": "POST", "path": "/api/torrents", "json": { "ok": true, "torrent": { "id": "tr_deb13", "infoHash": "3f8a6c2e9b1d4f7a0c5e8b2d6f9a1c4e7b0d3f6a", "name": "Debian.13.0.0.amd64.netinst.iso", "status": "adding", "progress": 0 } } }
