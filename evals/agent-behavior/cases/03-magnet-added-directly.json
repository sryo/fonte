        { "type": "notCalled", "match": { "method": "POST", "path": "/api/search", "body": { "query": { "$not": { "$regex": "3f8a6c2e9b1d4f7a0c5e8b2d6f9a1c4e7b0d3f6a", "$flags": "i" } } } }, "why": "runs no title search (rule 4)" }
    ],
    "golden": {
