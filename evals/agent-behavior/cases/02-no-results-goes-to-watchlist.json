{
    "id": "no-results-goes-to-watchlist",
    "title": "When the search comes back empty, the title goes on the watchlist and the user is told",
    "expectation": "pass",
    "message": "Download Glass Orchard (2026)",
    "responses": [
        { "method": "POST", "path": "/api/search", "json": { "ok": true, "query": "Glass Orchard", "year": 2026, "quality": "1080p", "resultCount": 0, "results": [] } },
        {
            "method": "POST", "path": "/api/watchlist",
            "json": { "ok": true, "entry": { "id": "wl_go2026", "title": "Glass Orchard", "year": 2026, "mediaType": "movie", "quality": "1080p", "status": "watching", "searchQuery": "Glass Orchard 2026 1080p", "newResultsCount": 0 } }
        }
    ],
    "assert": [
        { "type": "called", "match": { "method": "POST", "path": "/api/search", "body": { "query": { "$regex": "glass orchard", "$flags": "i" } } }, "why": "searches first (rule 1)" },
        { "type": "called", "match": { "method": "POST", "path": "/api/watchlist", "body": { "title": { "$regex": "glass orchard", "$flags": "i" } } }, "why": "adds to the watchlist when nothing is found (rule 3)" },
        { "type": "before", "first": { "method": "POST", "path": "/api/search" }, "then": { "method": "POST", "path": "/api/watchlist" }, "why": "the watchlist add follows the empty search" },
        { "type": "notCalled", "match": { "method": "POST", "path": "/api/torrents" }, "why": "adds no torrent" },
        { "type": "text", "match": { "$regex": "watch|monitor", "$flags": "i" }, "why": "tells the user it is being monitored (rule 3)" }
    ],
    "golden": {
        "calls": [
            { "method": "POST", "path": "/api/search", "body": { "query": "Glass Orchard", "year": 2026 } },
            { "method": "POST", "path": "/api/watchlist", "body": { "title": "Glass Orchard", "year": 2026, "mediaType": "movie" } }
        ],
        "text": "Nothing out yet for Glass Orchard (2026). I added it to the watchlist, so it gets checked every 30 minutes."
    },
    "bad": [
        { "calls": [{ "method": "POST", "path": "/api/search", "body": { "query": "Glass Orchard" } }], "text": "I couldn't find Glass Orchard. Want me to watch for it?" },
        { "calls": [{ "method": "POST", "path": "/api/watchlist", "body": { "title": "Glass Orchard" } }], "text": "Added Glass Orchard to the watchlist." }
    ]
}
